# Copie para ".env" (na raiz do projeto) e ajuste. O arquivo .env NÃO vai para o Git.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Só obrigatórias com DEBUG=False. Ver docs/deploy-vercel.md para gerar.
# CHAVES_CIFRAGEM=
# CHAVE_HASH_CPF=
# Produção: domínio com https, separado por vírgulas.
# CSRF_TRUSTED_ORIGINS=https://exemplo.vercel.app
# Segredo do cron diário. Vazio desliga a rota.
# CRON_SECRET=
# Só para Postgres local sem SSL. Em produção, deixe de fora.
# DB_SSL=False
# Vazio = usa SQLite local (back-end/db.sqlite3). Em produção, use a URL do PostgreSQL:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
